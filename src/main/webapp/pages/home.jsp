<body>
<div class="container">
    <div class="row">
        <nav class="navbar">
            <h1>Eventsphere</h1>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#events">Events</a></li>
                <li><a href="#teacher">Teacher</a></li>
                <li><a href="#student">Student</a></li>
                <li><a href="#about">About Us</a></li>
                <li><a href="#contact">Contact Us</a></li>
